        }

        .sub-card:hover {
            border-color: #93c5fd;
            box-shadow: 0 6px 16px rgba(37,99,235,0.08);
            transform: translateY(-2px);
        }

        .sub-card-content {
            flex: 1;
            min-width: 0;
        }

        .sub-card-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 4px;
        }

        .sub-card-meta {
            font-size: 12px;
            color: var(--gray-600);
            margin-bottom: 8px;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .sub-card-price {
            font-size: 15px;
            font-weight: 800;
            color: var(--success);
        }

        .sub-card-img-wrapper {
            width: 110px;
            height: 95px;
            border-radius: 10px;
            overflow: hidden;
            flex-shrink: 0;
            background: #cbd5e1;
        }

        .sub-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .sub-card:hover .sub-card-img {
            transform: scale(1.08);
        }

        .empty-state {
            padding: 30px;
            text-align: center;
            color: var(--gray-400);
            background: var(--white);
            border: 1px dashed var(--gray-200);
            border-radius: 12px;
            font-size: 14px;
        }
    </style>
</head>
