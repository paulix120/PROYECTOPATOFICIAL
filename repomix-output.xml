          <span>⭐</span> Reseñas y Reputación
          <span class="nav-badge" id="badgeResenasSinResponder">0</span>
        </button>
        <button class="nav-item" data-section="perfil"><span>🛡️</span> Perfil y Documentos</button>
      </nav>

      <div class="sidebar-footer">
        <div class="account-status-card">
          <small>Estado de cuenta</small>
          <div class="status-line">
            <span class="dot-online"></span>
            <strong id="estadoProveedorSidebar">Verificando...</strong>
          </div>
          <span class="nit-text" id="nitSidebar">NIT: --</span>
        </div>
        <button class="btn-outline btn-full" onclick="cerrarSesion()">Cerrar Sesión</button>
      </div>
    </aside>

    <div class="main-wrapper">
      <header class="topbar">
        <div class="topbar-left">
          <button class="btn-icon mobile-only" id="btnToggleMenu">☰</button>
          <div>
            <h1 id="pageTitle">Resumen General</h1>
            <p id="pageSubtitle">Monitorea tus ingresos, reservas activas y oferta turística.</p>
          </div>
        </div>

        <div class="topbar-actions">
          <div class="notification-wrapper">
            <button class="btn-icon" id="btnNotificaciones" title="Notificaciones">
              🔔 <span class="notif-dot" id="notifCount">0</span>
            </button>
            <div class="notification-dropdown hidden" id="notifDropdown">
              <div class="notif-header">
                <strong>Notificaciones</strong>
              </div>
              <div class="notif-list" id="notifList"></div>
            </div>
          </div>

          <div class="user-pill">
