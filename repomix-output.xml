              <span>Rol: Proveedor</span>
            </div>
          </div>
        </div>
      </header>

      <main class="content-area">
        <!-- 1. RESUMEN -->
        <section id="sec-resumen" class="view-section active">
          <div class="kpi-grid">
            <article class="kpi-card">
              <div class="kpi-top">
                <span class="kpi-label">Ingresos Netos</span>
                <span class="kpi-icon kpi-green">💵</span>
              </div>
              <strong class="kpi-value" id="kpiIngresos">$0 COP</strong>
              <span class="kpi-sub" id="kpiPendiente">Por liquidar: $0 COP</span>
            </article>

            <article class="kpi-card">
              <div class="kpi-top">
                <span class="kpi-label">Reservas Activas</span>
                <span class="kpi-icon kpi-blue">📅</span>
              </div>
              <strong class="kpi-value" id="kpiReservasActivas">0</strong>
              <span class="kpi-sub" id="kpiReservasFinalizadas">0 finalizadas</span>
            </article>

            <article class="kpi-card">
              <div class="kpi-top">
                <span class="kpi-label">Reputación Promedio</span>
                <span class="kpi-icon kpi-amber">⭐</span>
              </div>
              <strong class="kpi-value" id="kpiCalificacion">0.0 / 5.0</strong>
              <span class="kpi-sub" id="kpiTotalResenas">Basado en 0 reseñas</span>
            </article>

            <article class="kpi-card">
              <div class="kpi-top">
                <span class="kpi-label">Servicios Publicados</span>
                <span class="kpi-icon kpi-purple">🏨</span>
              </div>
              <strong class="kpi-value" id="kpiTotalServicios">0</strong>
              <span class="kpi-sub" id="kpiServiciosDisponibles">0 disponibles ahora</span>
            </article>
          </div>

          <div class="grid-two-cols">
            <article class="panel-card">
              <div class="panel-header">
                <div>
                  <h2>Próximas Reservas</h2>
                  <p>Servicios agendados por viajeros</p>
                </div>
                <button class="btn-link" onclick="navegarA('reservas')">Ver agenda completa →</button>
              </div>
