<file path="estructura_PAT2.sql">
-- ============================================================
-- 1. CREACIÓN Y SELECCIÓN DE LA BASE DE DATOS
-- ============================================================
DROP DATABASE IF EXISTS PAT2;
CREATE DATABASE PAT2 CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
USE PAT2;

-- ============================================================
-- 2. TABLAS MAESTRAS O BÁSICAS (Sin Llaves Foráneas)
-- ============================================================

-- Tabla de Roles del sistema
CREATE TABLE rol (
  id_rol INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(50) NOT NULL UNIQUE,
  descripcion TEXT DEFAULT NULL
);

-- Tabla de Continentes
CREATE TABLE continente (
  id_conti INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(50) NOT NULL UNIQUE
);

-- Tabla de Tipos de Turismo
CREATE TABLE tp_turismo (
  id_tp_turi INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL UNIQUE,
  descripcion TEXT DEFAULT NULL
);

-- Tabla de Tipos de Servicio (Hospedaje, Transporte, Gastronomía, etc.)
CREATE TABLE tp_servicio (
  id_tp_serv INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(80) NOT NULL UNIQUE,
  descripcion TEXT DEFAULT NULL
);

-- Tabla de Gamas de Servicio (Económica, Media, Lujo, etc.)
CREATE TABLE gama (
  id_gama INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(50) NOT NULL,
  descripcion TEXT DEFAULT NULL
);

-- Tabla de Métodos de Pago
CREATE TABLE metodo_pago (
  id_met_pago INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(80) NOT NULL,
  descripcion TEXT DEFAULT NULL
);

-- Tabla de Políticas
CREATE TABLE politica (
  id_poli INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(150) NOT NULL,
  descripcion TEXT NOT NULL,
  estado ENUM('ACTIVA', 'INACTIVA') DEFAULT 'ACTIVA'
);


-- ============================================================
-- 3. UBICACIÓN GEOGRÁFICA (Países, Departamentos, Ciudades, Ubicaciones)
-- ============================================================

-- Tabla de Países
CREATE TABLE pais (
  id_pais INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL UNIQUE,
  id_conti INT NOT NULL,
  CONSTRAINT fk_pais_continente FOREIGN KEY (id_conti) REFERENCES continente (id_conti)
);

-- Tabla de Departamentos
CREATE TABLE departamento (
  id_depart INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL,
  id_pais INT NOT NULL,
  CONSTRAINT fk_departamento_pais FOREIGN KEY (id_pais) REFERENCES pais (id_pais)
);

-- Tabla de Ciudades
CREATE TABLE ciudad (
  id_cdad INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL,
  id_depart INT NOT NULL,
  CONSTRAINT fk_ciudad_departamento FOREIGN KEY (id_depart) REFERENCES departamento (id_depart)
);

-- Tabla de Ubicaciones específicas
CREATE TABLE ubicacion (
  id_ubi INT AUTO_INCREMENT PRIMARY KEY,
  direccion VARCHAR(255) NOT NULL,
  barrio VARCHAR(100) DEFAULT NULL,
  codigo_postal VARCHAR(15) DEFAULT NULL,
  latitud DECIMAL(10,8) NOT NULL,
  longitud DECIMAL(11,8) NOT NULL,
  descripcion TEXT DEFAULT NULL,
  id_cdad INT NOT NULL,
  activo TINYINT(1) DEFAULT 1,
  CONSTRAINT fk_ubicacion_ciudad FOREIGN KEY (id_cdad) REFERENCES ciudad (id_cdad)
);


-- ============================================================
-- 4. USUARIOS, SOLICITUDES Y PROVEEDORES
-- ============================================================

-- Tabla de Usuarios
CREATE TABLE usuario (
  id_usu INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL,
  apellido VARCHAR(100) NOT NULL,
  email VARCHAR(150) NOT NULL UNIQUE,
  password_hash VARCHAR(255) NOT NULL,
  id_rol INT NOT NULL DEFAULT 1,
  activo TINYINT(1) DEFAULT 1,
  token_recuperacion VARCHAR(255) DEFAULT NULL,
  token_expiracion DATETIME DEFAULT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  CONSTRAINT fk_usuario_rol FOREIGN KEY (id_rol) REFERENCES rol (id_rol)
);

-- Tabla de Solicitud para ser Proveedor
CREATE TABLE solicitud_proveedor (
  id_sp INT AUTO_INCREMENT PRIMARY KEY,
  id_usu INT NOT NULL,
  nit VARCHAR(20) NOT NULL UNIQUE,
  razon_social VARCHAR(150) NOT NULL,
  telefono_contacto VARCHAR(20) NOT NULL,
  cuenta_bancaria VARCHAR(50) NOT NULL,
  banco VARCHAR(50) NOT NULL,
  estado ENUM('EN_REVISION', 'APROBADA', 'RECHAZADA') DEFAULT 'EN_REVISION',
  fecha_solicitud DATETIME DEFAULT CURRENT_TIMESTAMP,
  observaciones TEXT DEFAULT NULL,
  CONSTRAINT fk_solicitud_usuario FOREIGN KEY (id_usu) REFERENCES usuario (id_usu)
);

-- Tabla Intermedia: Tipos de servicio que solicita ofrecer un proveedor
CREATE TABLE solicitud_tp_servicio (
  id_sol_serv INT AUTO_INCREMENT PRIMARY KEY,
  id_sp INT NOT NULL,
  id_tp_serv INT NOT NULL,
  CONSTRAINT fk_sol_serv_sp FOREIGN KEY (id_sp) REFERENCES solicitud_proveedor (id_sp) ON DELETE CASCADE,
  CONSTRAINT fk_sol_serv_tp FOREIGN KEY (id_tp_serv) REFERENCES tp_servicio (id_tp_serv)
);

-- Tabla de Proveedores Aprobados
CREATE TABLE proveedor (
  id_prov INT AUTO_INCREMENT PRIMARY KEY,
