                    { nombre: "Sendero Peatonal Ecológico", info: "Caminata guiada por la montaña", precio: "Gratuito", img: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=300" }
                ]
            },
            {
                id_servicio: 2,
                nombre: "Hotel Movich Buró 26",
                descripcion: "Hotel 5 estrellas de lujo ubicado en el sector Salitre cerca al aeropuerto El Dorado, con suites modernas, spa y centro de negocios.",
                id_tp_serv: 1,
                imagen_principal: "https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=600",
                ubicacion: { direccion: "Calle 26 # 69-76", barrio: "Salitre", codigo_postal: "110931" },
                gama_nombre: "Lujo",
                turismo_nombre: "Descanso / Ejecutivo",
                sub_items: [
                    { nombre: "Habitación Standard", info: "Capacidad: 2 personas | Check-in: 15:00", precio: "$350,000 / noche", img: SUB_IMGS_FALLBACK.habitacion1 },
                    { nombre: "Suite Ejecutiva", info: "Capacidad: 4 personas | Jacuzzi + Desayuno", precio: "$750,000 / noche", img: SUB_IMGS_FALLBACK.habitacion2 }
                ]
            },
            {
                id_servicio: 3,
                nombre: "Andrés Carne de Res Usaquén",
                descripcion: "El más representativo restaurante de gastronomía típica colombiana, carnes a la parrilla, rumba y coctelería.",
                id_tp_serv: 2,
                imagen_principal: "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=600",
                ubicacion: { direccion: "Calle 11 # 82-71", barrio: "Usaquén", codigo_postal: "110111" },
                gama_nombre: "Alta",
                turismo_nombre: "Gastronómico",
                sub_items: [
                    { nombre: "Bandeja Paisa Completa", info: "1 porción | Chicharrón, frijoles y aguacate", precio: "$45,000 COP", img: SUB_IMGS_FALLBACK.plato1 },
                    { nombre: "Lomo al Trapo Andrés", info: "2 porciones | Corte fino de res sellado al fuego", precio: "$85,000 COP", img: SUB_IMGS_FALLBACK.plato2 }
                ]
            },
            {
                id_servicio: 4,
                nombre: "Expreso Palmira Premium",
                descripcion: "Servicio de transporte terrestre de dos pisos de alta gama con sillas reclinables, Wi-Fi y conductores certificados.",
                id_tp_serv: 4,
                imagen_principal: "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?q=80&w=600",
                ubicacion: { direccion: "Terminal de Transporte", barrio: "Salitre", codigo_postal: "110931" },
                gama_nombre: "Media",
                turismo_nombre: "Transporte Terrestre",
                sub_items: [
                    { nombre: "Ruta Bogotá - Cali VIP", info: "42 pasajeros | Salidas cada hora", precio: "$85,000 COP", img: SUB_IMGS_FALLBACK.transporte }
                ]
            },
            {
